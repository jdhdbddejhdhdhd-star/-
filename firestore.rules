rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Orders collection: clients create & read their table orders; staff can update & manage
    match /orders/{orderId} {
      allow read, write: if true;
    }
    // Menu items collection: real-time menu synchronization
    match /menu_items/{itemId} {
      allow read, write: if true;
    }
    // Categories collection
    match /categories/{catId} {
      allow read, write: if true;
    }
    // Valid table QR tokens
    match /table_tokens/{tableId} {
      allow read, write: if true;
    }
  }
}
